---
const onHome = Astro.url.pathname === '/';
const href = (anchor) => onHome ? `#${anchor}` : `/#${anchor}`;
---
<footer class="site-footer">
  <div class="shell footer-main">
    <div class="footer-brand-block">
      <a class="brand footer-brand" href="/">
        <img src="/logo.png" alt="Logo Connect" width="40" height="40" class="brand-logo" />
        <span>Connect</span>
      </a>
      <p>Conseil commercial & marketing BtoB à Aix-en-Provence.</p>
    </div>

    <div class="footer-col desktop-footer-col">
      <strong>Navigation</strong>
      <a href={href('services')}>Services</a><a href={href('methode')}>Méthode</a><a href={href('about')}>À propos</a><a href={href('contact')}>Contact</a>
    </div>
    <div class="footer-col desktop-footer-col">
      <strong>Local</strong>
      <span>Aix-en-Provence</span><span>Marseille</span><span>Bouches-du-Rhône</span><span>PACA</span>
    </div>
    <div class="footer-col">
      <strong>Légal</strong>
      <a href="/mentions-legales.html">Mentions légales</a>
      <a href="/politique-confidentialite.html">Politique de confidentialité</a>
      <a href="mailto:valentin@connect-affaires.fr">valentin@connect-affaires.fr</a>
    </div>
  </div>
  <div class="shell footer-bottom">© 2026 Connect</div>
</footer>
