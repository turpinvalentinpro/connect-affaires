    {'@type':'FAQPage',mainEntity:[
      {'@type':'Question',name:'À qui s’adresse le conseil commercial de Connect ?',acceptedAnswer:{'@type':'Answer',text:'Aux TPE, PME, indépendants et dirigeants qui souhaitent clarifier leur développement commercial ou remettre de l’ordre dans leur organisation.'}},
