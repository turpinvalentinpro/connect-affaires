  {'@type':'Service','@id':canonical+'#service',name:'CRM et organisation commerciale à Aix-en-Provence',serviceType:'CRM commercial et organisation commerciale',provider:{'@id':'https://www.connect-affaires.fr/#business'},areaServed:{'@type':'City',name:'Aix-en-Provence'},description},
