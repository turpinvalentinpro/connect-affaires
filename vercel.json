{
  "redirects": [
    {
      "source": "/ressources/structurer-developpement-commercial-pme.html",
      "destination": "/structurer-developpement-commercial-pme.html",
      "permanent": true
    },
    {
      "source": "/ressources/marketing-btob-tpe-pme.html",
      "destination": "/marketing-btob-tpe-pme.html",
      "permanent": true
    },
    {
      "source": "/cas-clients/fer-de-lance.html",
      "destination": "/cas-client-fer-de-lance.html",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/preview.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
