{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "public",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index(.html)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/a-propos.html",
      "destination": "/a-propos",
      "permanent": true
    },
    {
      "source": "/acquisition-btob-aix-en-provence.html",
      "destination": "/acquisition-btob-aix-en-provence",
      "permanent": true
    },
    {
      "source": "/cas-client-fer-de-lance.html",
      "destination": "/cas-client-fer-de-lance",
      "permanent": true
    },
    {
      "source": "/conseil-commercial-aix-en-provence.html",
      "destination": "/conseil-commercial-aix-en-provence",
      "permanent": true
    },
    {
      "source": "/crm-organisation-commerciale-aix-en-provence.html",
      "destination": "/crm-organisation-commerciale-aix-en-provence",
      "permanent": true
    },
    {
      "source": "/marketing-btob-aix-en-provence.html",
      "destination": "/marketing-btob-aix-en-provence",
      "permanent": true
    },
    {
      "source": "/marketing-btob-tpe-pme.html",
      "destination": "/marketing-btob-tpe-pme",
      "permanent": true
    },
    {
      "source": "/mentions-legales.html",
      "destination": "/mentions-legales",
      "permanent": true
    },
    {
      "source": "/politique-de-confidentialite.html",
      "destination": "/politique-de-confidentialite",
      "permanent": true
    },
    {
      "source": "/ressources.html",
      "destination": "/ressources",
      "permanent": true
    },
    {
      "source": "/structurer-developpement-commercial-pme.html",
      "destination": "/structurer-developpement-commercial-pme",
      "permanent": true
    },
    {
      "source": "/politique-confidentialite",
      "destination": "/politique-de-confidentialite",
      "permanent": true
    },
    {
      "source": "/politique-confidentialite.html",
      "destination": "/politique-de-confidentialite",
      "permanent": true
    },
    {
      "source": "/ressources/structurer-developpement-commercial-pme(.html)?",
      "destination": "/structurer-developpement-commercial-pme",
      "permanent": true
    },
    {
      "source": "/ressources/marketing-btob-tpe-pme(.html)?",
      "destination": "/marketing-btob-tpe-pme",
      "permanent": true
    },
    {
      "source": "/cas-clients/fer-de-lance(.html)?",
      "destination": "/cas-client-fer-de-lance",
      "permanent": true
    },
    {
      "source": "/preview(.html)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin(/.*)?",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webm|jpg|png|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(styles\\.css|site\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/a-propos",
      "destination": "/a-propos.html"
    },
    {
      "source": "/acquisition-btob-aix-en-provence",
      "destination": "/acquisition-btob-aix-en-provence.html"
    },
    {
      "source": "/cas-client-fer-de-lance",
      "destination": "/cas-client-fer-de-lance.html"
    },
    {
      "source": "/conseil-commercial-aix-en-provence",
      "destination": "/conseil-commercial-aix-en-provence.html"
    },
    {
      "source": "/crm-organisation-commerciale-aix-en-provence",
      "destination": "/crm-organisation-commerciale-aix-en-provence.html"
    },
    {
      "source": "/marketing-btob-aix-en-provence",
      "destination": "/marketing-btob-aix-en-provence.html"
    },
    {
      "source": "/marketing-btob-tpe-pme",
      "destination": "/marketing-btob-tpe-pme.html"
    },
    {
      "source": "/mentions-legales",
      "destination": "/mentions-legales.html"
    },
    {
      "source": "/politique-de-confidentialite",
      "destination": "/politique-de-confidentialite.html"
    },
    {
      "source": "/ressources",
      "destination": "/ressources.html"
    },
    {
      "source": "/structurer-developpement-commercial-pme",
      "destination": "/structurer-developpement-commercial-pme.html"
    }
  ]
}